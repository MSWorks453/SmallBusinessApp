# ─── Database ─────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your real connection string.
# .env is gitignored; this example file is safe to commit.

# Neon (free tier)      https://neon.tech
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require
#
# Supabase (free tier)  https://supabase.com  → Project Settings → Database → Connection string
#   Use the "Connection pooling" URI on port 6543 for serverless-friendly pooling.
#   DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Render (free tier)   https://render.com  → your Postgres instance → Connections
#   Use the EXTERNAL Database URL for local development. The Internal URL's short
#   host (dpg-xxxx-a) only resolves inside Render's network and will fail locally
#   with "getaddrinfo ENOTFOUND dpg-xxxx-a".
#   DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxx-a.REGION-postgres.render.com/DBNAME
#
# Local Postgres
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smallbusiness

DATABASE_URL=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Force-disable TLS. SSL is auto-enabled for any non-localhost host, so you
# normally do not need this. Set to "disable" only for a non-TLS remote host.
# PGSSLMODE=disable

# Max pooled connections. Keep this low on free tiers (Neon/Supabase cap it).
# PG_POOL_MAX=10

# Log every SQL statement with timing. Useful while debugging.
# DB_LOG_QUERIES=false

# API port
# PORT=4000

# ─── Authentication (required) ────────────────────────────────────────────────
# Login is SMS OTP. There are no passwords; the tokens below are the only
# credentials the API issues.

# Signing key for access-token JWTs. REQUIRED — the server refuses to start
# without it, because signing with an empty secret makes every token forgeable.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value invalidates every access token in circulation (clients
# recover automatically by refreshing), so it is safe to rotate.
JWT_SECRET=

# ─── Authentication (optional — sensible defaults shown) ──────────────────────

# Access-token lifetime. Short on purpose: it is the window in which a stolen
# token stays usable, and the client refreshes transparently. Accepts s/m/h/d.
# ACCESS_TOKEN_TTL=15m

# Refresh-token lifetime, i.e. how long a device stays signed in while in use.
# Each refresh resets the clock, so an active user is never logged out.
# REFRESH_TOKEN_TTL_DAYS=30

# Country dial code applied to numbers typed without one. The seeded staff data
# is 10-digit Indian mobile numbers.
# AUTH_DEFAULT_COUNTRY_CODE=+91

# Separate pepper for hashing OTP codes. Falls back to JWT_SECRET when unset;
# set it if you want to rotate the two independently.
# OTP_PEPPER=

# OTP limits. These, not the 6-digit length, are what make the codes safe:
# a code is guessable in 1-in-a-million per try, so the caps are the real
# defence. Loosening them meaningfully weakens login.
# OTP_TTL_MINUTES=5              how long a code stays valid
# OTP_MAX_ATTEMPTS=5             wrong guesses before the code is burned
# OTP_RESEND_COOLDOWN_SECONDS=60 minimum gap between codes for one number
# OTP_MAX_REQUESTS_PER_HOUR=5    per-number hourly cap (bounds SMS cost too)

# Return "this number isn't registered" instead of a generic success when an
# unknown number requests a code. Better error messages, but it lets anyone
# test whether a given number belongs to your staff. Default false.
# AUTH_REVEAL_UNKNOWN_PHONE=false

# ─── SMS delivery ─────────────────────────────────────────────────────────────
# console  (default) Prints the code to the server log and returns it in the API
#          response so the flow is testable with no provider account. Never
#          use this outside development — it hands out login codes to any caller.
# twilio   Real delivery via Twilio's REST API.
# SMS_PROVIDER=console

# Sender name shown inside the message body.
# SMS_APP_NAME=FinTrack

# Required when SMS_PROVIDER=twilio. Supply either TWILIO_FROM_NUMBER or
# TWILIO_MESSAGING_SERVICE_SID; the messaging service is preferred if both exist.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to '*' so Expo Go on a LAN IP works
# during development. Set this in production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ─── Scheduled reports (the report bot) ───────────────────────────────────────
# Pushes a daily and a monthly summary to every active ADMIN employee's WhatsApp.
# Recipients come from the employees table (role=ADMIN, status=active, phone set),
# so promoting someone starts their reports with no deploy.

# Master switch. Anything other than "false" leaves the scheduler on.
# REPORTS_ENABLED=true

# Cron expressions, evaluated in REPORT_TIMEZONE (not the host's zone).
# Daily default 20:00 — after the working day, so attendance is already marked.
# Monthly default 09:00 on the 1st, reporting the month that just closed.
# REPORT_DAILY_CRON=0 20 * * *
# REPORT_MONTHLY_CRON=0 9 1 * *

# Timezone the schedule and the meaning of "today" are resolved in. Containers
# almost always run UTC, so setting this is what makes 8pm mean local 8pm.
# REPORT_TIMEZONE=Asia/Kolkata

# The scheduler is in-process, so a restart or a host that spins down would
# silently skip a day. On boot it backfills missed daily reports going this far
# back. Capped at 14; keep it low so a long outage does not fire a burst of
# messages (each one costs money on a real provider).
# REPORT_CATCH_UP_DAYS=3

# Extra recipients beyond the ADMIN employees — an owner who is not on payroll,
# or a shared ops number. Comma-separated, normalised to E.164 automatically.
# REPORT_EXTRA_RECIPIENTS=+919876543210,+919812345678

# Cosmetic: currency symbol and the name the report signs off with.
# REPORT_CURRENCY=₹
# REPORT_BUSINESS_NAME=FinTrack

# ─── WhatsApp delivery ────────────────────────────────────────────────────────
# console  (default) Prints the report to the server log; nothing is sent. Lets
#          the schedule, figures and wording be tested with no WhatsApp Business
#          account and no per-message cost.
# twilio   Real delivery through Twilio's WhatsApp channel.
# WHATSAPP_PROVIDER=console

# READ THIS BEFORE SWITCHING TO twilio.
#
# WhatsApp only allows free-form text within 24 hours of the recipient messaging
# you. A scheduled report is business-initiated and outside that window, so it
# MUST reference a pre-approved Content Template by SID. Since 1 April 2025
# Twilio rejects template text sent as a plain body with error 63016.
#
# Steps:
#   1. GET /api/reports/templates (as an ADMIN) returns the exact bodies to
#      submit, plus sample values filled in from your real data.
#   2. Create them in Twilio's Content Template Builder and submit for WhatsApp
#      approval. Automatic triage is quick; human review can take up to 48h.
#   3. Put the resulting Content SIDs ('HX…') below.
#
# WHATSAPP_DAILY_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_MONTHLY_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# template  (default) Production path — uses the Content SIDs above.
# freeform  Sends the rendered text as a plain body. ONLY works in the Twilio
#           sandbox, or inside the 24-hour window. Useful to see a real message
#           on your phone before templates are approved: join the sandbox from
#           WhatsApp first, then set this.
# WHATSAPP_MESSAGE_MODE=template

# Sender. For the Twilio sandbox this is whatsapp:+14155238886 — and every
# recipient must first join the sandbox by messaging it the join code.
# Supply either a from number or a messaging service, not both.
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=

# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN are shared with SMS above.
